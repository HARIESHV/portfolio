# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (server-side only, never exposed to the browser)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Resend API key (server-side only, never exposed to the browser)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form notifications are delivered
CONTACT_EMAIL=harieshvenkatachalam@gmail.com

# Verified sender for Resend. Must be a domain you own and verified in Resend.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Comma-separated list of allowed browser origins for CORS.
# Leave as localhost during development. Set to your deployed frontend URL in production.
CLIENT_URL=http://localhost:5173

# Public site URL, used for Open Graph / canonical tags on the deployed frontend
PUBLIC_SITE_URL=https://your-domain.com

# Comma-separated list of allowed origins for the Vercel deployment (optional)
ALLOWED_ORIGINS=
